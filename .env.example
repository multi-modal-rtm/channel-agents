# Copy to .env and fill in your values.
# python-dotenv loads this automatically via pydantic-settings (env_file=".env").

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=channel-agents
ENVIRONMENT=development          # development | production
DEBUG=false

# Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-64-char-hex-secret

# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme-generate-a-fernet-key

# ── Database — Neon ───────────────────────────────────────────────────────────
# https://neon.tech → New project → Connection Details
# Select driver: "asyncpg" (or copy the libpq string and swap the scheme)
# sslmode=require is mandatory for Neon.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-000000.us-east-1.aws.neon.tech/channel_agents?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis — Upstash ───────────────────────────────────────────────────────────
# https://console.upstash.com → Create Database → Details → "rediss://" URL
# Must be rediss:// (TLS). Plain redis:// will be rejected by Upstash.
REDIS_URL=rediss://default:your-token@example-endpoint.upstash.io:6379

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
# https://cloud.qdrant.io → Create Cluster → Dashboard → API Keys
QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Platform key used for managed-billing tenants (no BYOK).
# Tenants on BYOK have their own key stored encrypted in the DB.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY_MANAGED=sk-ant-
# ── Langfuse (observability) ──────────────────────────────────────────────────
# https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Meta / Instagram ──────────────────────────────────────────────────────────
# https://developers.facebook.com → App → Settings → Basic
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── Telegram ──────────────────────────────────────────────────────────────────
# @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
# https://dash.voyageai.com → API Keys
VOYAGE_API_KEY=pa-
